<!DOCTYPE html>
<html lang="en-AU">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if page_title %}{{ page_title }} — {% endif %}{{ site_name }}</title>
<meta name="description" content="{{ meta_description }}">
{% if canonical %}<link rel="canonical" href="{{ canonical }}">{% endif %}
<style>
:root{--ink:#1a2332;--mut:#5a6b80;--bg:#f6f8fa;--card:#fff;--line:#d9e1ea;--acc:#0e7a5f;--acc-d:#0a5c48;--warn:#b3541e}
*{box-sizing:border-box}
body{font:16px/1.6 -apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;color:var(--ink);background:var(--bg);margin:0}
main{max-width:960px;margin:0 auto;padding:1rem 1.25rem 4rem}
header.site{background:var(--acc);color:#fff;padding:.75rem 1.25rem}
header.site .inner{max-width:960px;margin:0 auto;display:flex;flex-wrap:wrap;gap:.5rem;align-items:baseline;justify-content:space-between}
header.site a{color:#fff;text-decoration:none;font-weight:700;font-size:1.05rem}
header.site nav a{font-weight:500;font-size:.9rem;opacity:.9;margin-left:1rem}
h1{font-size:1.6rem;line-height:1.25;margin:.8rem 0 .4rem}
.updated{color:var(--mut);font-size:.85rem;margin:0 0 1.2rem}
.card{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:1rem 1.25rem;margin:1rem 0}
.card h2{font-size:1.15rem;margin:.2rem 0 .6rem}
table{border-collapse:collapse;width:100%;margin:.6rem 0;font-size:.92rem}
th,td{border:1px solid var(--line);padding:.45rem .6rem;text-align:left;vertical-align:top}
th{background:#eef3f7;font-weight:600}
.num{text-align:right;white-space:nowrap}
.badge{display:inline-block;background:#e7f5ef;color:var(--acc-d);border-radius:99px;padding:.05rem .6rem;font-size:.75rem;font-weight:600;vertical-align:middle}
.badge.warn{background:#fdeee4;color:var(--warn)}
.badge.grey{background:#eef1f4;color:var(--mut)}
.cta{display:inline-block;background:var(--acc);color:#fff !important;border-radius:8px;padding:.5rem 1rem;text-decoration:none;font-weight:600;font-size:.95rem}
.cta:hover{background:var(--acc-d)}
.disclosure{font-size:.78rem;color:var(--mut);border-top:1px solid var(--line);margin-top:2rem;padding-top:.8rem}
nav.crumbs{font-size:.85rem;color:var(--mut);margin:.6rem 0 0}
nav.crumbs a{color:var(--acc-d);text-decoration:none}
ul.links{padding-left:1.2rem;margin:.4rem 0}
ul.links li{margin:.25rem 0}
footer.site{color:var(--mut);font-size:.8rem;max-width:960px;margin:0 auto;padding:1rem 1.25rem 3rem}
</style>
</head>
<body>
<header class="site"><div class="inner">
  <a href="{{ base_url }}/">🗑️ {{ site_name }}</a>
  <nav><a href="{{ base_url }}/councils/">Councils</a> <a href="{{ base_url }}/research/which-bin-basics.html">Which bin</a> <a href="{{ base_url }}/about.html">About</a></nav>
</div></header>
<main>
<nav class="crumbs"><a href="{{ base_url }}/">Home</a>{% for c in crumbs %} › <a href="{{ c.url }}">{{ c.label }}</a>{% endfor %}</nav>
<h1>{{ h1 }}</h1>
<p class="updated">Updated {{ build_date }} · sources checked at build time</p>
{{ body | safe }}
<div class="disclosure">{{ affiliate_disclosure }}</div>
</main>
<footer class="site">{{ site_name }} · bin days, which bin, hard rubbish &amp; skip permits · Rebuilt nightly by an agent · <a href="{{ base_url }}/about.html" style="color:inherit">About &amp; contact</a></footer>
</body>
</html>
